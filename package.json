  "keywords": [
    "garri",
    "nigerian-food",
    "subscription",
    "pantry-staples",
    "supply-chain",
    "jit-logistics",
    "ai-demand-forecasting"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
