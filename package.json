    "landing": "npx serve landing-page",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "job:forecast": "tsx jobs/forecast.ts",
    "job:cycles": "tsx jobs/cycles.ts",
    "canonical:migrate": "tsx scripts/canonical.ts migrate",
    "canonical:verify": "tsx scripts/canonical.ts verify",
    "canonical:report": "tsx scripts/canonical.ts report",
    "converge": "tsx scripts/converge.ts",
    "job:converge": "tsx jobs/converge.ts"
  },
  "directories": {
    "docs": "docs"
  },
  "engines": {
