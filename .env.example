# Copy to .env and adjust. Prisma loads this via dotenv in prisma.config.ts.

# Postgres — matches the docker-compose.yml db service (`npm run db:up`)
DATABASE_URL="postgresql://oja:oja@localhost:5432/oja_dev"

# Supabase (Google OAuth) — required to activate production auth
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Canonical Postgres (Supabase project DB in prod; local PG in dev/CI)
SUPABASE_DB_URL="postgresql://oja@127.0.0.1:5433/oja_canonical"
# OAuth redirect base per environment (localhost / preview / production)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
