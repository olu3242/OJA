// Oja schema v1 — see docs/ARCHITECTURE.md §3 for the target data model.
// Task 0.3 scope: accounts, skus, price_books. Order/pantry/inventory/
// procurement/forecast/demand-event models land in task 0.4.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- accounts ----------

enum AccountRole {
  HOUSEHOLD
  SUPPLIER
  STORE
  RESTAURANT
  COMMUNITY
  WAREHOUSE
  ADMIN
}

enum NetTermsStatus {
  NONE
  REQUESTED
  APPROVED
  SUSPENDED
}

model Account {
  id    String      @id @default(cuid())
  role  AccountRole
  email String      @unique
  phone String?
  name  String

  // B2B fields — wholesale pricing must never render unless b2bVerified
  businessName   String?
  b2bVerified    Boolean        @default(false)
  b2bVerifiedAt  DateTime?
  netTermsStatus NetTermsStatus @default(NONE)

  // Fulfillment context
  deliveryZone String?

  // Supplier-portal link (Phase 2, task 4.5)
  supplierId String?

  subscriptions Subscription[]
  orders        Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@map("accounts")
}

// ---------- skus ----------

enum SkuCategory {
  GRAINS_FLOURS
  TUBERS
  OILS
  DRIED_FISH_PROTEINS
  SPICES_SEASONINGS
  FRESH_PRODUCE
  FROZEN
}

enum PerishabilityClass {
  SHELF_STABLE
  REFRIGERATED
  FROZEN
  FRESH
}

model Sku {
  id   String @id @default(cuid())
  code String @unique // internal SKU code, e.g. "GAR-IJEBU-5KG"

  // Naming: English name always paired with local names for search,
  // e.g. nameEn "Melon seed", localNames ["Egusi", "Agushi"]
  nameEn     String
  localNames String[] @default([])

  category      SkuCategory
  perishability PerishabilityClass
  brand         String?
  originCountry String // ISO 3166-1 alpha-2, e.g. "NG"

  // Unit definition — one Sku row per sellable unit size
  unitSize        String // display, e.g. "5 kg bag"
  unitWeightGrams Int?

  halal         Boolean @default(false)
  shelfLifeDays Int?

  // Compliance (FDA / CFIA labeling — see PRD §5)
  allergens            String[] @default([])
  countryOfOriginLabel String?
  fdaLabelingNotes     String?
  cfiaLabelingNotes    String? // Canada (Phase 3, task 5.3)
  importPermitRequired Boolean  @default(false)

  // Substitution graph (self many-to-many, directed)
  substitutes  Sku[] @relation("SkuSubstitutes")
  substituteOf Sku[] @relation("SkuSubstitutes")

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  priceBookEntries PriceBookEntry[]
  poLines          PoLine[]
  lots             Lot[]
  orderLines       OrderLine[]
  forecasts        Forecast[]

  @@index([category])
  @@index([active])
  @@map("skus")
}

// ---------- price_books ----------

enum PriceTier {
  RETAIL // Oja Market one-off pricing
  MEMBER // Oja Pantry subscriber pricing
  WHOLESALE // verified B2B pricing
}

model PriceBook {
  id            String    @id @default(cuid())
  tier          PriceTier
  name          String // e.g. "US retail 2026-Q3"
  currency      String    @default("USD") // ISO 4217
  active        Boolean   @default(true)
  effectiveFrom DateTime  @default(now())

  entries PriceBookEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tier, active])
  @@map("price_books")
}

model PriceBookEntry {
  id          String @id @default(cuid())
  priceBookId String
  skuId       String

  unitPriceCents Int
  minQty         Int @default(1) // quantity-break support

  priceBook PriceBook @relation(fields: [priceBookId], references: [id], onDelete: Cascade)
  sku       Sku       @relation(fields: [skuId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([priceBookId, skuId, minQty])
  @@map("price_book_entries")
}

// ---------- warehouses & procurement ----------

model Warehouse {
  id     String @id @default(cuid())
  code   String @unique
  name   String
  region String

  lots           Lot[]
  purchaseOrders PurchaseOrder[]
  forecasts      Forecast[]

  createdAt DateTime @default(now())

  @@map("warehouses")
}

model Supplier {
  id           String  @id @default(cuid())
  name         String
  country      String // ISO 3166-1 alpha-2
  contactEmail String?
  fastPay      Boolean @default(false)

  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("suppliers")
}

enum PoStatus {
  DRAFT
  PLACED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id          String    @id @default(cuid())
  supplierId  String
  warehouseId String
  status      PoStatus  @default(DRAFT)
  expectedAt  DateTime?
  placedAt    DateTime?

  supplier  Supplier  @relation(fields: [supplierId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  lines     PoLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("purchase_orders")
}

model PoLine {
  id            String @id @default(cuid())
  poId          String
  skuId         String
  qtyUnits      Int
  unitCostCents Int
  receivedUnits Int    @default(0)

  po   PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  sku  Sku           @relation(fields: [skuId], references: [id])
  lots Lot[]

  @@map("po_lines")
}

// ---------- inventory ledger (append-only) ----------

model Lot {
  id          String    @id @default(cuid())
  skuId       String
  warehouseId String
  poLineId    String?
  lotCode     String    @unique
  expiresAt   DateTime?
  receivedAt  DateTime  @default(now())

  sku       Sku            @relation(fields: [skuId], references: [id])
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  poLine    PoLine?        @relation(fields: [poLineId], references: [id])
  txns      InventoryTxn[]

  @@index([skuId, warehouseId, expiresAt])
  @@map("lots")
}

enum TxnType {
  RECEIVE
  QC_FAIL
  PICK
  SHIP
  ADJUST
  TRANSFER_OUT
  TRANSFER_IN
}

model InventoryTxn {
  id          String  @id @default(cuid())
  lotId       String
  type        TxnType
  qtyUnits    Int // signed: + inbound, - outbound
  orderLineId String?
  reason      String?

  lot       Lot        @relation(fields: [lotId], references: [id])
  orderLine OrderLine? @relation(fields: [orderLineId], references: [id])

  createdAt DateTime @default(now())

  @@index([lotId])
  @@index([orderLineId])
  @@map("inventory_txns")
}

// ---------- subscriptions & cycles (PRD v0.2 Garri plans) ----------

enum PlanTier {
  STARTER
  FAMILY
  STOCK_UP
}

enum GarriVariety {
  WHITE_IJEBU
  YELLOW
}

enum GarriGrind {
  COARSE
  FINE
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

model Subscription {
  id          String             @id @default(cuid())
  accountId   String
  plan        PlanTier
  variety     GarriVariety
  grind       GarriGrind         @default(COARSE)
  cadenceDays Int                @default(30)
  qtyLbs      Int
  priceCents  Int
  currency    String             @default("USD")
  status      SubscriptionStatus @default(ACTIVE)
  pausedAt    DateTime?
  cancelledAt DateTime?

  account Account @relation(fields: [accountId], references: [id])
  cycles  Cycle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([status])
  @@map("subscriptions")
}

enum CycleStatus {
  UPCOMING
  CONFIRMED
  SKIPPED
  ORDERED
  FULFILLED
}

model Cycle {
  id             String      @id @default(cuid())
  subscriptionId String
  scheduledFor   DateTime
  status         CycleStatus @default(UPCOMING)
  confirmedAt    DateTime?

  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  order        Order?

  createdAt DateTime @default(now())

  @@index([subscriptionId, scheduledFor])
  @@index([status, scheduledFor])
  @@map("cycles")
}

// ---------- orders ----------

enum OrderStatus {
  PENDING
  PAID
  PICKING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id             String      @id @default(cuid())
  accountId      String
  subscriptionId String?
  cycleId        String?     @unique
  status         OrderStatus @default(PENDING)
  totalCents     Int
  addressLine1   String
  city           String
  state          String
  zip            String
  country        String      @default("US")
  carrier        String?
  trackingCode   String?
  shippedAt      DateTime?
  deliveredAt    DateTime?

  account Account     @relation(fields: [accountId], references: [id])
  cycle   Cycle?      @relation(fields: [cycleId], references: [id])
  lines   OrderLine[]
  refunds Refund[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([status])
  @@map("orders")
}

model OrderLine {
  id             String @id @default(cuid())
  orderId        String
  skuId          String
  qtyUnits       Int
  unitPriceCents Int

  order Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku   Sku            @relation(fields: [skuId], references: [id])
  txns  InventoryTxn[]

  @@map("order_lines")
}

model Refund {
  id          String @id @default(cuid())
  orderId     String
  reasonCode  String
  amountCents Int

  order Order @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())

  @@map("refunds")
}

// ---------- forecasts (versioned inserts, never updated) ----------

enum ForecastSource {
  V0
  V1
  OVERRIDE
}

model Forecast {
  id           String         @id @default(cuid())
  skuId        String
  warehouseId  String
  weekStart    DateTime
  qtyUnits     Int
  source       ForecastSource
  version      Int
  overrideOfId String?
  reasonCode   String?

  sku        Sku        @relation(fields: [skuId], references: [id])
  warehouse  Warehouse  @relation(fields: [warehouseId], references: [id])
  overrideOf Forecast?  @relation("ForecastOverride", fields: [overrideOfId], references: [id])
  overrides  Forecast[] @relation("ForecastOverride")

  createdAt DateTime @default(now())

  @@index([skuId, warehouseId, weekStart])
  @@map("forecasts")
}

// ---------- demand events (append-only intent stream) ----------

enum DemandEventType {
  SUBSCRIBE
  SELL_THROUGH
  CONFIRM
  EDIT
  SKIP
  PAUSE
  RESUME
  CANCEL
  SWAP
  SHORTAGE_SWAP
  OOS_VIEW
  REFUND
  DELIVERY
}

model DemandEvent {
  id             String          @id @default(cuid())
  type           DemandEventType
  accountId      String?
  subscriptionId String?
  cycleId        String?
  orderId        String?
  skuId          String?
  payload        Json?

  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([skuId, createdAt])
  @@map("demand_events")
}

// ---------- misc ----------

model WholesaleLead {
  id           String  @id @default(cuid())
  businessName String
  email        String
  businessType String
  message      String?

  createdAt DateTime @default(now())

  @@map("wholesale_leads")
}

model NotificationLog {
  id        String  @id @default(cuid())
  accountId String?
  channel   String // sms | email
  template  String
  payload   Json?

  createdAt DateTime @default(now())

  @@map("notification_logs")
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  COMPLETED
}

model TransferOrder {
  id              String         @id @default(cuid())
  fromWarehouseId String
  toWarehouseId   String
  skuId           String
  qtyUnits        Int
  status          TransferStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("transfer_orders")
}

// ---------- group buying (tasks 3.3 / 4.4) ----------

enum GroupOrderStatus {
  OPEN
  CLOSED
  FULFILLED
}

model GroupOrder {
  id           String           @id @default(cuid())
  code         String           @unique // shareable link slug
  creatorId    String
  status       GroupOrderStatus @default(OPEN)
  // Single delivery point (community/church drop)
  addressLine1 String
  city         String
  state        String
  zip          String
  orderId      String? // aggregated order once closed

  members GroupOrderMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("group_orders")
}

model GroupOrderMember {
  id           String       @id @default(cuid())
  groupOrderId String
  accountId    String
  plan         PlanTier
  variety      GarriVariety
  priceCents   Int
  qtyLbs       Int

  groupOrder GroupOrder @relation(fields: [groupOrderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([groupOrderId, accountId])
  @@map("group_order_members")
}
